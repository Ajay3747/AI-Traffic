// ============================================================
// AMBULANCE GPS + EMERGENCY PRIORITY SYSTEM
// ============================================================

// ------------------------------------------------------------
// CONFIGURATION
// ------------------------------------------------------------

const SIGNAL_LOCATION = {
  signalId: 'SIG-001',
  name: process.env.SIGNAL_NAME || 'Prototype Junction',

  latitude:
    Number.parseFloat(process.env.SIGNAL_LATITUDE) ||
    11.275600,

  longitude:
    Number.parseFloat(process.env.SIGNAL_LONGITUDE) ||
    77.583200,

  // 50 meter geofence
  geofenceRadius:
    Number.parseFloat(process.env.GEOFENCE_RADIUS) ||
    50,
};

// GPS must arrive within 15 seconds
const GPS_TIMEOUT_MS =
  Number.parseInt(process.env.GPS_TIMEOUT_MS, 10) ||
  15000;

// Heading tolerance
const HEADING_TOLERANCE =
  Number.parseFloat(process.env.HEADING_TOLERANCE) ||
  45;

// Heading is trusted only above 5 km/h
const MIN_HEADING_SPEED_KMH =
  Number.parseFloat(process.env.MIN_HEADING_SPEED_KMH) ||
  5;


// ------------------------------------------------------------
// AMBULANCE STATE
// ------------------------------------------------------------

function defaultAmbulanceState() {
  return {
    ambulanceId: null,

    emergency: false,

    latitude: null,
    longitude: null,
    accuracy: null,

    heading: null,
    speed: null,

    direction: null,
    directionSource: null,

    distance: null,

    insideGeofence: false,

    signalPriority: false,

    lastUpdate: null,
  };
}

let ambulanceState = defaultAmbulanceState();


// ------------------------------------------------------------
// EMERGENCY OVERRIDE STATE
// ------------------------------------------------------------

let ambulanceEmergencyActive = false;

let savedSignalStateBeforeAmbulance = null;


// ============================================================
// HAVERSINE DISTANCE
// ============================================================

function haversineDistanceMeters(
  lat1,
  lon1,
  lat2,
  lon2
) {
  const R = 6371000;

  const toRad = (value) =>
    (value * Math.PI) / 180;

  const dLat =
    toRad(lat2 - lat1);

  const dLon =
    toRad(lon2 - lon1);

  const a =
    Math.sin(dLat / 2) ** 2 +
    Math.cos(toRad(lat1)) *
      Math.cos(toRad(lat2)) *
      Math.sin(dLon / 2) ** 2;

  const c =
    2 *
    Math.atan2(
      Math.sqrt(a),
      Math.sqrt(1 - a)
    );

  return R * c;
}


// ============================================================
// NORMALIZE HEADING
// ============================================================

function normalizeHeading(heading) {

  if (
    typeof heading !== 'number' ||
    !Number.isFinite(heading)
  ) {
    return null;
  }

  if (heading < 0) {
    heading = heading % 360 + 360;
  }

  return heading % 360;
}


// ============================================================
// ANGULAR DIFFERENCE
// ============================================================

function headingDifference(a, b) {

  let diff =
    Math.abs(a - b);

  if (diff > 180) {
    diff = 360 - diff;
  }

  return diff;
}


// ============================================================
// HEADING → ROAD
// ============================================================
//
// 0°   = North
// 90°  = East
// 180° = South
// 270° = West
//
// Example:
// heading 10°  → North
// heading 85°  → East
// heading 175° → South
// heading 265° → West
//
// ±45° tolerance is used.
// ============================================================

function directionFromHeading(heading) {

  if (heading == null) {
    return null;
  }

  const directions = [
    {
      name: 'North',
      bearing: 0,
    },
    {
      name: 'East',
      bearing: 90,
    },
    {
      name: 'South',
      bearing: 180,
    },
    {
      name: 'West',
      bearing: 270,
    },
  ];

  let bestDirection = null;
  let smallestDifference = Infinity;

  for (const item of directions) {

    const difference =
      headingDifference(
        heading,
        item.bearing
      );

    if (
      difference <
      smallestDifference
    ) {
      smallestDifference =
        difference;

      bestDirection =
        item.name;
    }
  }

  if (
    smallestDifference <=
    HEADING_TOLERANCE
  ) {
    return bestDirection;
  }

  return null;
}


// ============================================================
// POSITION FALLBACK
// ============================================================
//
// Used only when heading is unavailable/unreliable.
//
// This is NOT the primary direction method.
// ============================================================

function directionFromPosition(
  latitude,
  longitude
) {

  const dLat =
    latitude -
    SIGNAL_LOCATION.latitude;

  const dLon =
    longitude -
    SIGNAL_LOCATION.longitude;

  if (
    Math.abs(dLat) >=
    Math.abs(dLon)
  ) {

    if (dLat >= 0) {
      return 'North';
    }

    return 'South';
  }

  if (dLon >= 0) {
    return 'East';
  }

  return 'West';
}


// ============================================================
// DETECT APPROACH DIRECTION
// ============================================================

function detectApproachDirection(
  latitude,
  longitude,
  heading,
  speed
) {

  // ----------------------------------------------------------
  // PRIMARY METHOD: GPS HEADING
  // ----------------------------------------------------------

  const validHeading =
    normalizeHeading(heading);

  const validSpeed =
    typeof speed === 'number' &&
    Number.isFinite(speed)
      ? speed
      : null;

  if (
    validHeading !== null &&
    validSpeed !== null &&
    validSpeed >=
      MIN_HEADING_SPEED_KMH
  ) {

    const headingDirection =
      directionFromHeading(
        validHeading
      );

    if (headingDirection) {

      return {
        direction:
          headingDirection,

        source:
          'gps-heading',
      };
    }
  }


  // ----------------------------------------------------------
  // FALLBACK
  // ----------------------------------------------------------

  return {
    direction:
      directionFromPosition(
        latitude,
        longitude
      ),

    source:
      'position-fallback',
  };
}


// ============================================================
// START AMBULANCE EMERGENCY
// ============================================================

function startAmbulanceEmergency(
  direction
) {

  if (
    !SIGNAL_ROADS.includes(
      direction
    )
  ) {

    console.warn(
      `[AMBULANCE] Invalid direction: ${direction}`
    );

    return;
  }


  // Already active
  if (
    ambulanceEmergencyActive
  ) {

    // Update direction dynamically
    signalState.activeRoad =
      direction;

    signalState.emergency =
      true;

    signalState.isSimulating =
      true;

    signalState.simulationFinished =
      false;

    return;
  }


  // ----------------------------------------------------------
  // SAVE NORMAL TRAFFIC STATE
  // ----------------------------------------------------------

  savedSignalStateBeforeAmbulance = {
    activeRoad:
      signalState.activeRoad,

    emergency:
      signalState.emergency,

    timerRemaining:
      signalState.timerRemaining,

    isSimulating:
      signalState.isSimulating,

    simulationFinished:
      signalState.simulationFinished,
  };


  // ----------------------------------------------------------
  // STOP NORMAL TIMER
  // ----------------------------------------------------------

  stopSignalTimer();


  // ----------------------------------------------------------
  // ACTIVATE EMERGENCY
  // ----------------------------------------------------------

  ambulanceEmergencyActive =
    true;

  signalState.isSimulating =
    true;

  signalState.simulationFinished =
    false;

  signalState.emergency =
    true;

  signalState.activeRoad =
    direction;

  signalState.timerRemaining =
    0;


  console.log(
    `[AMBULANCE] 🚑 EMERGENCY GREEN → ${direction}`
  );
}


// ============================================================
// END AMBULANCE EMERGENCY
// ============================================================

function endAmbulanceEmergency() {

  if (
    !ambulanceEmergencyActive
  ) {
    return;
  }

  ambulanceEmergencyActive =
    false;


  const saved =
    savedSignalStateBeforeAmbulance;

  savedSignalStateBeforeAmbulance =
    null;


  if (!saved) {

    signalState =
      defaultSignalState();

    return;
  }


  // ----------------------------------------------------------
  // RESTORE NORMAL TRAFFIC
  // ----------------------------------------------------------

  signalState.activeRoad =
    saved.activeRoad;

  signalState.emergency =
    saved.emergency;

  signalState.timerRemaining =
    saved.timerRemaining;

  signalState.isSimulating =
    saved.isSimulating;

  signalState.simulationFinished =
    saved.simulationFinished;


  console.log(
    '[AMBULANCE] Emergency ended → normal traffic restored'
  );


  // ----------------------------------------------------------
  // RESTART NORMAL TIMER
  // ----------------------------------------------------------

  if (
    saved.isSimulating &&
    signalState.vehicleCounts
  ) {

    stopSignalTimer();

    signalTimer =
      setInterval(
        tickSignal,
        1000
      );
  }
}


// ============================================================
// APPLY AMBULANCE PRIORITY
// ============================================================
//
// This is the SINGLE source of truth.
//
// Every GPS update comes here.
// ============================================================

function applyAmbulancePriority() {

  // ----------------------------------------------------------
  // NO GPS
  // ----------------------------------------------------------

  if (
    ambulanceState.latitude === null ||
    ambulanceState.longitude === null
  ) {

    ambulanceState.insideGeofence =
      false;

    ambulanceState.signalPriority =
      false;

    return;
  }


  // ----------------------------------------------------------
  // DISTANCE
  // ----------------------------------------------------------

  const distance =
    Math.round(
      haversineDistanceMeters(
        ambulanceState.latitude,
        ambulanceState.longitude,

        SIGNAL_LOCATION.latitude,
        SIGNAL_LOCATION.longitude
      )
    );


  ambulanceState.distance =
    distance;


  // ----------------------------------------------------------
  // DIRECTION
  // ----------------------------------------------------------

  const directionResult =
    detectApproachDirection(
      ambulanceState.latitude,
      ambulanceState.longitude,
      ambulanceState.heading,
      ambulanceState.speed
    );


  ambulanceState.direction =
    directionResult.direction;

  ambulanceState.directionSource =
    directionResult.source;


  // ----------------------------------------------------------
  // GEOFENCE
  // ----------------------------------------------------------

  ambulanceState.insideGeofence =
    distance <=
    SIGNAL_LOCATION.geofenceRadius;


  console.log(
    `[AMBULANCE] ` +
    `GPS=${ambulanceState.latitude.toFixed(6)},${ambulanceState.longitude.toFixed(6)} ` +
    `heading=${ambulanceState.heading ?? 'N/A'}° ` +
    `speed=${ambulanceState.speed ?? 'N/A'}km/h ` +
    `distance=${distance}m ` +
    `direction=${ambulanceState.direction} ` +
    `source=${ambulanceState.directionSource} ` +
    `inside=${ambulanceState.insideGeofence}`
  );


  // ----------------------------------------------------------
  // LEAVE GEOFENCE
  // ----------------------------------------------------------

  if (
    ambulanceState.emergency &&
    !ambulanceState.insideGeofence
  ) {

    console.log(
      '[AMBULANCE] 🚑 LEFT 50m GEOFENCE'
    );

    ambulanceState.emergency =
      false;
  }


  // ----------------------------------------------------------
  // SIGNAL PRIORITY
  // ----------------------------------------------------------

  ambulanceState.signalPriority =
    ambulanceState.emergency &&
    ambulanceState.insideGeofence;


  // ----------------------------------------------------------
  // APPLY / REMOVE EMERGENCY
  // ----------------------------------------------------------

  if (
    ambulanceState.signalPriority &&
    ambulanceState.direction
  ) {

    startAmbulanceEmergency(
      ambulanceState.direction
    );

  }

  else if (
    ambulanceEmergencyActive
  ) {

    endAmbulanceEmergency();
  }
}


// ============================================================
// GPS WATCHDOG
// ============================================================
//
// If the ambulance phone stops sending GPS for 15 seconds,
// emergency priority is automatically removed.
// ============================================================

setInterval(() => {

  if (
    ambulanceState.emergency &&
    ambulanceState.lastUpdate &&
    Date.now() -
      ambulanceState.lastUpdate >
      GPS_TIMEOUT_MS
  ) {

    console.warn(
      '[AMBULANCE] ⚠️ GPS TIMEOUT - emergency cleared'
    );


    ambulanceState.emergency =
      false;

    ambulanceState.signalPriority =
      false;


    if (
      ambulanceEmergencyActive
    ) {

      endAmbulanceEmergency();
    }
  }

}, 2000);


// ============================================================
// START EMERGENCY
// ============================================================

app.post(
  '/api/ambulance/start',
  (req, res) => {

    const {
      ambulanceId
    } = req.body;


    if (!ambulanceId) {

      return res.status(400).json({
        success: false,
        message:
          'ambulanceId is required',
      });
    }


    ambulanceState.ambulanceId =
      ambulanceId;


    // --------------------------------------------------------
    // GPS REQUIRED
    // --------------------------------------------------------

    if (
      ambulanceState.latitude === null ||
      ambulanceState.longitude === null
    ) {

      return res.json({

        success: false,

        emergency: false,

        insideGeofence: false,

        message:
          'Waiting for GPS location',

      });
    }


    // --------------------------------------------------------
    // CHECK GEOFENCE BEFORE GRANTING EMERGENCY
    // --------------------------------------------------------

    applyAmbulancePriority();


    if (
      !ambulanceState.insideGeofence
    ) {

      return res.json({

        success: false,

        emergency: false,

        insideGeofence: false,

        direction:
          ambulanceState.direction,

        directionSource:
          ambulanceState.directionSource,

        distance:
          ambulanceState.distance,

        message:
          `Ambulance must be within ${SIGNAL_LOCATION.geofenceRadius} meters of the junction`,

      });
    }


    // --------------------------------------------------------
    // GRANT EMERGENCY
    // --------------------------------------------------------

    ambulanceState.emergency =
      true;

    ambulanceState.lastUpdate =
      Date.now();


    applyAmbulancePriority();


    console.log(
      `[AMBULANCE] 🚨 EMERGENCY STARTED ` +
      `→ ${ambulanceState.direction}`
    );


    return res.json({

      success: true,

      emergency:
        ambulanceState.emergency,

      insideGeofence:
        ambulanceState.insideGeofence,

      signalPriority:
        ambulanceState.signalPriority,

      ambulanceId:
        ambulanceState.ambulanceId,

      latitude:
        ambulanceState.latitude,

      longitude:
        ambulanceState.longitude,

      accuracy:
        ambulanceState.accuracy,

      heading:
        ambulanceState.heading,

      speed:
        ambulanceState.speed,

      direction:
        ambulanceState.direction,

      directionSource:
        ambulanceState.directionSource,

      distance:
        ambulanceState.distance,

      signalName:
        SIGNAL_LOCATION.name,

    });
  }
);


// ============================================================
// LOCATION UPDATE
// ============================================================
//
// Phone should call this every 1-3 seconds.
// ============================================================

app.post(
  '/api/ambulance/location',
  (req, res) => {

    const {
      ambulanceId,
      latitude,
      longitude,
      accuracy,
      heading,
      speed,
      emergency,
    } = req.body;


    // --------------------------------------------------------
    // VALIDATION
    // --------------------------------------------------------

    if (
      !ambulanceId ||
      typeof latitude !== 'number' ||
      typeof longitude !== 'number'
    ) {

      return res.status(400).json({

        success: false,

        message:
          'ambulanceId, latitude and longitude are required',

      });
    }


    // --------------------------------------------------------
    // STORE GPS
    // --------------------------------------------------------

    ambulanceState.ambulanceId =
      ambulanceId;

    ambulanceState.latitude =
      latitude;

    ambulanceState.longitude =
      longitude;

    ambulanceState.accuracy =
      typeof accuracy === 'number'
        ? accuracy
        : null;

    ambulanceState.heading =
      normalizeHeading(
        heading
      );

    ambulanceState.speed =
      typeof speed === 'number'
        ? speed
        : null;

    ambulanceState.lastUpdate =
      Date.now();


    // --------------------------------------------------------
    // EXPLICIT STOP
    // --------------------------------------------------------

    if (
      emergency === false
    ) {

      ambulanceState.emergency =
        false;
    }


    // --------------------------------------------------------
    // RECALCULATE EVERYTHING
    // --------------------------------------------------------

    applyAmbulancePriority();


    // --------------------------------------------------------
    // LOG
    // --------------------------------------------------------

    console.log(
      `[AMBULANCE LOCATION] ` +
      `${ambulanceId} | ` +
      `lat=${latitude.toFixed(6)} | ` +
      `lon=${longitude.toFixed(6)} | ` +
      `heading=${ambulanceState.heading ?? 'N/A'} | ` +
      `speed=${ambulanceState.speed ?? 'N/A'} | ` +
      `direction=${ambulanceState.direction} | ` +
      `distance=${ambulanceState.distance}m | ` +
      `inside=${ambulanceState.insideGeofence} | ` +
      `emergency=${ambulanceState.emergency}`
    );


    return res.json({

      success: true,

      ambulanceId:
        ambulanceState.ambulanceId,

      latitude:
        ambulanceState.latitude,

      longitude:
        ambulanceState.longitude,

      accuracy:
        ambulanceState.accuracy,

      heading:
        ambulanceState.heading,

      speed:
        ambulanceState.speed,

      emergency:
        ambulanceState.emergency,

      insideGeofence:
        ambulanceState.insideGeofence,

      direction:
        ambulanceState.direction,

      directionSource:
        ambulanceState.directionSource,

      distance:
        ambulanceState.distance,

      signalPriority:
        ambulanceState.signalPriority,

      signalName:
        SIGNAL_LOCATION.name,

    });
  }
);


// ============================================================
// STOP EMERGENCY
// ============================================================

app.post(
  '/api/ambulance/stop',
  (req, res) => {

    ambulanceState.emergency =
      false;

    ambulanceState.signalPriority =
      false;


    if (
      ambulanceEmergencyActive
    ) {

      endAmbulanceEmergency();
    }


    console.log(
      '[AMBULANCE] Emergency manually stopped'
    );


    return res.json({

      success: true,

      emergency: false,

      signalPriority: false,

    });
  }
);


// ============================================================
// AMBULANCE STATUS
// ============================================================

app.get(
  '/api/ambulance/status',
  (req, res) => {

    return res.json({

      success: true,

      ambulanceId:
        ambulanceState.ambulanceId,

      emergency:
        ambulanceState.emergency,

      latitude:
        ambulanceState.latitude,

      longitude:
        ambulanceState.longitude,

      accuracy:
        ambulanceState.accuracy,

      heading:
        ambulanceState.heading,

      speed:
        ambulanceState.speed,

      insideGeofence:
        ambulanceState.insideGeofence,

      direction:
        ambulanceState.direction,

      directionSource:
        ambulanceState.directionSource,

      distance:
        ambulanceState.distance,

      signalPriority:
        ambulanceState.signalPriority,

      signalName:
        SIGNAL_LOCATION.name,

      geofenceRadius:
        SIGNAL_LOCATION.geofenceRadius,

    });
  }
);


// ============================================================
// TEST EMERGENCY
// ============================================================
//
// This lets you test ESP32 without moving the phone.
//
// POST:
// /api/emergency/test
//
// Body:
// {
//   "direction": "North"
// }
//
// ============================================================

app.post(
  '/api/emergency/test',
  (req, res) => {

    const {
      direction
    } = req.body;


    if (
      !SIGNAL_ROADS.includes(
        direction
      )
    ) {

      return res.status(400).json({

        success: false,

        message:
          `direction must be one of: ${SIGNAL_ROADS.join(', ')}`,

      });
    }


    ambulanceState.ambulanceId =
      ambulanceState.ambulanceId ||
      'TEST-AMB';


    ambulanceState.emergency =
      true;

    ambulanceState.signalPriority =
      true;

    ambulanceState.direction =
      direction;

    ambulanceState.directionSource =
      'test';

    ambulanceState.distance =
      0;

    ambulanceState.insideGeofence =
      true;

    ambulanceState.lastUpdate =
      Date.now();


    startAmbulanceEmergency(
      direction
    );


    console.log(
      `[TEST] 🚑 Emergency → ${direction}`
    );


    return res.json({

      success: true,

      emergency: true,

      direction,

      distance: 0,

      insideGeofence: true,

      signalPriority: true,

    });
  }
);


// ============================================================
// CLEAR TEST EMERGENCY
// ============================================================

app.post(
  '/api/emergency/clear',
  (req, res) => {

    ambulanceState =
      defaultAmbulanceState();


    if (
      ambulanceEmergencyActive
    ) {

      endAmbulanceEmergency();
    }


    console.log(
      '[TEST] Emergency cleared'
    );


    return res.json({

      success: true,

      emergency: false,

    });
  }
);